msgstr "%1 варианта на глифа."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:24
#, kde-format
msgctxt "@title"
msgid "Access All Alternates"
msgstr "Достъп до всички алтернативи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:25
#, kde-format
msgctxt "@tooltip"
msgid "Access any possible substitutions."
msgstr "Достъп до всички възможни заместители."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:29
#, kde-format
msgctxt "@title"
msgid "Contextual Alternates"
msgstr "Контекстуални алтернативи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:30
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs depending on their context within a text."
msgstr "Замяна на глифите в зависимост от техния контекст в текста."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:33
#, kde-format
msgctxt "@title"
msgid "Contextual Ligatures"
msgstr "Контекстуални лигатури"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:34
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces sequences of glyphs with ligatures depending on their context "
"within a text."
msgstr ""
"Замяна на последователности от глифи с лигатури в зависимост от техния "
"контекст в текста."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:37
#, kde-format
msgctxt "@title"
msgid "Contextual Swash"
msgstr "Контекстуални декоративни елементи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:38
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces glyphs with swashed glyphs depending on their context within a text."
msgstr ""
"Замяна на глифи с декоративни глифи в зависимост от техния контекст в текста."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:41
#, kde-format
msgctxt "@title"
msgid "Discretionary Ligatures"
msgstr "Факултативни лигатури"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:42
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces sequences of glyphs with ligatures intended for typographic effect."
msgstr "Замяна на последователности от глифи с лигатури за типографски ефект."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:45
#, kde-format
msgctxt "@title"
msgid "Final Glyph on Line Alternates"
msgstr "Краен глиф при алтернативи в реда"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:46
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with their line-end forms."
msgstr "Замяна на глифите с техните форми за край на реда."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:49
#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:53
#, kde-format
msgctxt "@title"
msgid "Historical Forms"
msgstr "Исторически форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:50
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with their historical forms."
msgstr "Замяна на глифите с техните исторически форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:54
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces sequences glyphs with ligatures that were in use in the past, but "
"rare today."
msgstr ""
"Замяна на последователности от глифи с лигатури, които са били използвани в "
"миналото, но днес са редки."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:57
#, kde-format
msgctxt "@title"
msgid "Justification Alternates"
msgstr "Алтернативи за оправдаване"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:58
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with their alternates meant for justification."
msgstr "Замяна на глифи с техните алтернативи за оправдаване."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:61
#, kde-format
msgctxt "@title"
msgid "Standard Ligatures"
msgstr "Стандартни лигатури"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:62
#, kde-format
msgctxt "@tooltip"
msgid "Replaces sequences glyphs with common ligatures."
msgstr "Замяна на последователности от глифи с общи лигатури."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:65
#, kde-format
msgctxt "@title"
msgid "Left Bounds"
msgstr "Лява граница"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:66
#, kde-format
msgctxt "@tooltip"
msgid "This adjusts glyphs so there is no space at the left side."
msgstr ""
"Регулиране на глифите, така че да няма празно пространство от лявата страна."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:69
#, kde-format
msgctxt "@title"
msgid "Localized Forms"
msgstr "Локализирани форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:70
#, kde-format
msgctxt "@tooltip"
msgid "This replaces glyphs with language specific versions."
msgstr "Замяна на глифите с езиково специфични версии."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:73
#, kde-format
msgctxt "@title"
msgid "Optical Bounds"
msgstr "Оптични граници"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:74
#, kde-format
msgctxt "@tooltip"
msgid ""
"Adjusts glyphs so they align by their optical bounds. Doesn't do anything in "
"Krita."
msgstr ""
"Регулиране на глифовете така, че да бъдат подравнени по техните оптични "
"граници. Няма ефект в Krita."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:77
#, kde-format
msgctxt "@title"
msgid "Ornaments"
msgstr "Орнаменти"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:78
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with ornaments for decorative purposes."
msgstr "Замяна на глифи с орнаменти за декоративни цели."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:81
#, kde-format
msgctxt "@title"
msgid "Randomize"
msgstr "Рандомизиране"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:82
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with random alternates."
msgstr "Замяна на глифите с произволни алтернативи."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:85
#, kde-format
msgctxt "@title"
msgid "Right Bounds"
msgstr "Десни граници"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:86
#, kde-format
msgctxt "@tooltip"
msgid "This adjusts glyphs so there is no space at the right side."
msgstr ""
"Регулиране на глифовете, така че да няма празно пространство от дясната "
"страна."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:89
#, kde-format
msgctxt "@title"
msgid "Stylistic Alternates"
msgstr "Стилистични алтернативи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:90
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces glyphs with stylistic alternates that do not fit in other "
"categories."
msgstr ""
"Замяна на глифи със стилистични алтернативи, които не попадат в други "
"категории."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:93
#, kde-format
msgctxt "@title"
msgid "Swash"
msgstr "Декоративни елементи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:94
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with swashed alternates."
msgstr "Замяна на глифи с декоративни алтернативи."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:99
#, kde-format
msgctxt "@title"
msgid "Glyph Composition/Decomposition"
msgstr "Композиция/Декомпозиция на глифи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:100
#, kde-format
msgctxt "@tooltip"
msgid ""
"This composes or decomposes graphemes so that the resulting glyphs can later "
"be recomposed. Commonly used to handle diacritics."
msgstr ""
"Комбинира или разчленява графеми, така че резултиращите глифи да могат да "
"бъдат рекомбинирани по-късно. Обикновено се използва за работа с диакритични "
"знаци."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:103
#, kde-format
msgctxt "@title"
msgid "Kerning"
msgstr "Кернинг"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:104
#, kde-format
msgctxt "@tooltip"
msgid "This controls kerning on the font."
msgstr "Контрол на кернинга на шрифта."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:107
#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:111
#, kde-format
msgctxt "@title"
msgid "Mark Positioning"
msgstr "Позициониране на маркировки"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:108
#, kde-format
msgctxt "@tooltip"
msgid ""
"This controls the positioning of mark glyphs on base glyphs. Commonly used "
"for diacritics."
msgstr ""
"Контролира позиционирането на знаци-маркери върху базови знаци. Обикновено "
"се използва за диакритични знаци."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:112
#, kde-format
msgctxt "@tooltip"
msgid ""
"This controls the positioning of mark glyphs onto other mark glyphs. "
"Commonly used for diacritics."
msgstr ""
"Контролира позиционирането на знаковите глифи върху други знакови глифи. "
"Обикновено се използва за диакритици."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:115
#, kde-format
msgctxt "@title"
msgid "Required Contextual Alternates"
msgstr "Необходими контекстуални алтернативи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:116
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces glyphs contextually with alternates, required to make the font work."
msgstr ""
"Контекстуална замяна на глифи с алтернативни, необходима за правилното "
"функциониране на шрифта."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:119
#, kde-format
msgctxt "@title"
msgid "Required Ligatures"
msgstr "Задължителни лигатури"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:120
#, kde-format
msgctxt "@tooltip"
msgid "Replaces sequences of glyphs with required ligatures."
msgstr "Замяна на последователности от глифи с необходимите лигатури."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:123
#, kde-format
msgctxt "@title"
msgid "Required Variation Alternates"
msgstr "Задължителни вариационни алтернативи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:124
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces glyphs in a variable font with ones suited for the current "
"variation."
msgstr ""
"Замяна на глифите в вариативен шрифт с такива, подходящи за текущата "
"вариация."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:127
#, kde-format
msgctxt "@title"
msgid "Optical size"
msgstr "Оптичен размер"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:128
#, kde-format
msgctxt "@tooltip"
msgid ""
"Indicates how much the font is suitable for its current size. Does nothing "
"in Krita."
msgstr ""
"Показва доколко шрифтът е подходящ за текущия си размер. Няма ефект в Krita."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:131
#, kde-format
msgctxt "@title"
msgid "Vertical Kerning"
msgstr "Вертикално кернинг"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:132
#, kde-format
msgctxt "@tooltip"
msgid "This controls vertical kerning on the font."
msgstr "Контрол на вертикалния кернинг на шрифта."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:137
#, kde-format
msgctxt "@title"
msgid "Alternative Fractions"
msgstr "Алтернативни дроби"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:138
#, kde-format
msgctxt "@tooltip"
msgid "Replaces figures separated by a slash with a nut fraction form."
msgstr "Замяна на цифри, разделени със наклонена черта, с дробни форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:141
#, kde-format
msgctxt "@title"
msgid "Denominators"
msgstr "Знаменатели"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:142
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces figures with forms that are suited to represent the denominator in "
"a fraction."
msgstr ""
"Замяна на цифрите с форми, подходящи за представяне на знаменател в дроб."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:145
#, kde-format
msgctxt "@title"
msgid "Dotless Forms"
msgstr "Форми без точка"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:146
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces dotted letters such as i and j with dotless forms, for use in "
"mathematical formula."
msgstr ""
"Замяна на букви с точки (като i и j) с форми без точки, за употреба в "
"математически формули."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:149
#, kde-format
msgctxt "@title"
msgid "Flattened accent forms"
msgstr "Разflattenи форми на акцентите"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:150
#, kde-format
msgctxt "@tooltip"
msgid "Replaces accents on capital letters with flattened forms."
msgstr "Замяна на акцентите върху главните букви с изравнени форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:153
#, kde-format
msgctxt "@title"
msgid "Fractions"
msgstr "Дроби"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:154
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces figures separated by a slash with a proper diagonal fraction form. "
"If a font has the numerator and denominator features, and the numbers are "
"separated by a 'fraction slash' (U+2044), then this will replace the figures "
"with numerators before the slash and denominators after the slash."
msgstr ""
"Заменява цифрите, разделени със наклонена черта, с подходяща диагонална "
"дробна форма. Ако шрифтът разполага с характеристики за числител и "
"знаменател, а числата са разделени с „дробна наклонена черта“ (U+2044), "
"тогава цифрите ще бъдат заменени с числители преди чертата и знаменатели "
"след нея."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:157
#, kde-format
msgctxt "@title"
msgid "Lining Figures"
msgstr "Цифри за изравняване (Lining Figures)"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:158
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces oldstyle figures with lining figures, which harmonize well with "
"uppercase letters."
msgstr ""
"Замяна на старите цифри с такава от тип \"lining\", които се хармонизират "
"добре с главните букви."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:161
#, kde-format
msgctxt "@title"
msgid "Mathematical Greek"
msgstr "Математическа гръцка азбука"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:162
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces normal Greek script with glyphs intended for mathematical usage."
msgstr ""
"Замяна на стандартния гръцки шрифт с глифи, предназначени за математическа "
"употреба."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:165
#, kde-format
msgctxt "@title"
msgid "Alternate Annotation Forms"
msgstr "Алтернативни форми на анотациите"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:166
#, kde-format
msgctxt "@tooltip"
msgid "Replaces figures and letters with notational forms, like encircled."
msgstr "Замяна на цифри и букви с нотационни форми, например обградени."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:169
#, kde-format
msgctxt "@title"
msgid "Numerators"
msgstr "Числители"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:170
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces figures with forms that are suited to represent the numerator in a "
"fraction."
msgstr ""
"Замяна на цифрите с форми, подходящи за представяне на числителя в дроб."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:173
#, kde-format
msgctxt "@title"
msgid "Oldstyle Figures"
msgstr "Цифри в стар стил"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:174
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces lining figures with oldstyle figures, which harmonize well with "
"lowercase letters."
msgstr ""
"Замяна на цифри с линиен стил с цифри в стар стил, които се хармонизират "
"добре с малките букви."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:177
#, kde-format
msgctxt "@title"
msgid "Ordinals"
msgstr "Редни числа"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:178
#, kde-format
msgctxt "@tooltip"
msgid "Replaces letters that follow figures with their ordinal forms."
msgstr "Замяна на буквите след цифрите с техните порядкови форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:181
#, kde-format
msgctxt "@title"
msgid "Proportional Figures"
msgstr "Пропорционални цифри"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:182
#, kde-format
msgctxt "@tooltip"
msgid "Replaces tabular figures with proportional figures."
msgstr "Замяна на таблични цифри с пропорционални цифри."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:185
#, kde-format
msgctxt "@title"
msgid "Scientific Inferiors"
msgstr "Научни долни индекси"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:186
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces glyphs with forms that are suited for displaying the number in "
"chemical formulas."
msgstr ""
"Замяна на глифове с форми, подходящи за изобразяване на числа в химични "
"формули."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:189
#, kde-format
msgctxt "@title"
msgid "Math script style alternates"
msgstr "Алтернативи за математически стил на шрифта"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:190
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with ones more suited for super- and subscripts."
msgstr "Замяна на глифите с такива, по-подходящи за индекси (горни и долни)."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:193
#, kde-format
msgctxt "@title"
msgid "Subscript"
msgstr "Долен индекс"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:194
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with ones more suited for subscript."
msgstr "Замяна на глифите с такива, по-подходящи за индекс."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:197
#, kde-format
msgctxt "@title"
msgid "Superscript"
msgstr "Горен индекс"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:198
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with ones more suited for superscript."
msgstr "Замяна на глифите с такива, по-подходящи за индекс (горен индекс)."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:201
#, kde-format
msgctxt "@title"
msgid "Tabular Figures"
msgstr "Таблични цифри"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:202
#, kde-format
msgctxt "@tooltip"
msgid "Replaces proportional figures with tabular figures."
msgstr "Замяна на пропорционалните цифри с таблични цифри."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:205
#, kde-format
msgctxt "@title"
msgid "Slashed Zero"
msgstr "Прекръщена нула"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:206
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces the number zero with one that has a slash in the middle, which can "
"help prevent confusion with similar glyphs like the letter 'O'."
msgstr ""
"Замяна на числото нула с такава с наклонена черта в средата, което помага за "
"предотвратяване на объркване с подобни глифи като буквата 'O'."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:211
#, kde-format
msgctxt "@title"
msgid "Case-Sensitive Forms"
msgstr "Регистрозависими форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:212
#, kde-format
msgctxt "@tooltip"
msgid ""
"Adjusts glyphs to work better with text that consists of only capitals or "
"lining figures."
msgstr ""
"Регулиране на глифовете за по-добра съвместимост с текст, състоящ се само от "
"главни букви или линейни цифри."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:215
#, kde-format
msgctxt "@title"
msgid "Capital Spacing"
msgstr "Разстояние между главни букви"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:216
#, kde-format
msgctxt "@tooltip"
msgid "Adjusts inter-glyph spacing for all-capital text."
msgstr "Регулиране на разстоянието между глифите за текст само с главни букви."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:219
#, kde-format
msgctxt "@title"
msgid "Petite Capitals From Capitals"
msgstr "Малки главни букви от главни"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:220
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces uppercase letters with petite capital forms, which are closer to "
"the x-height of a font than small capital forms."
msgstr ""
"Замяна на главните букви с малки капитали (petite capitals), които са по-"
"близо до x-височината на шрифта от стандартните малки капитали."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:223
#, kde-format
msgctxt "@title"
msgid "Small Capitals From Capitals"
msgstr "Малки главни букви от главни"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:224
#, kde-format
msgctxt "@tooltip"
msgid "Replaces uppercase letters with small capital forms."
msgstr "Замяна на главните букви с малки капитали."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:227
#, kde-format
msgctxt "@title"
msgid "Petite Capitals"
msgstr "Малки капитали"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:228
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces lowercase letters with petite capital forms, which are closer to "
"the x-height of a font than small capital forms."
msgstr ""
"Заменяне на малките букви с малки капители (petite capitals), които са по-"
"близки до x-височината на шрифта от стандартните малки капители."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:231
#, kde-format
msgctxt "@title"
msgid "Small Capitals"
msgstr "Малки главни букви"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:232
#, kde-format
msgctxt "@tooltip"
msgid "Replaces lowercase letters with small capital forms."
msgstr "Замяна на малките букви с малки капитали."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:235
#, kde-format
msgctxt "@title"
msgid "Titling"
msgstr "Заглавни букви"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:236
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with alternate forms suited for header text."
msgstr "Замяна на глифи с алтернативни форми, подходящи за заглавия."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:239
#, kde-format
msgctxt "@title"
msgid "Unicase"
msgstr "Уникейс"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:240
#, kde-format
msgctxt "@tooltip"
msgid "Replaces both upper and lowercase glyphs with unicase glyphs."
msgstr "Замяна на главните и малките глифи с уникейс глифи."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:245
#, kde-format
msgctxt "@title"
msgid "Above-base Forms"
msgstr "Форми над основата"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:246
#, kde-format
msgctxt "@tooltip"
msgid ""
"Controls substitution for above base forms in Khmer and other Indic scripts"
msgstr ""
"Контрол на заместването за форми над базовите символи в кхмерски и други "
"индийски писмени"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:249
#, kde-format
msgctxt "@title"
msgid "Above-base Mark Positioning"
msgstr "Позициониране на марки над базовата линия"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:250
#, kde-format
msgctxt "@tooltip"
msgid "Controls above-base mark positioning for Indic scripts."
msgstr "Контрол на позиционирането на знаци над основата за индийски езици."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:253
#, kde-format
msgctxt "@title"
msgid "Above-base Substitutions"
msgstr "Заместители над основата"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:254
#, kde-format
msgctxt "@tooltip"
msgid "Controls above-base mark ligatures for Indic scripts."
msgstr "Контрол на лигатурите за знаци над базовата линия при индийски писма."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:257
#, kde-format
msgctxt "@title"
msgid "Akhand"
msgstr "Akhand"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:258
#, kde-format
msgctxt "@tooltip"
msgid "Controls Akhand ligatures for Indic scripts."
msgstr "Контрол на Akhand лигатурите за индийски азбуки."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:261
#, kde-format
msgctxt "@title"
msgid "Below-base Forms"
msgstr "Форми под базовата линия"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:262
#, kde-format
msgctxt "@tooltip"
msgid "Controls substitution for below base forms in Indic scripts."
msgstr "Контрол на заместите форми под базовите символи в индийските шрифтове."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:265
#, kde-format
msgctxt "@title"
msgid "Below-base Mark Positioning"
msgstr "Позициониране на знаци под базовата линия"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:266
#, kde-format
msgctxt "@tooltip"
msgid "Controls below-base mark positioning for Indic scripts."
msgstr "Контрол на позиционирането на знаци под основата за индийски езици."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:269
#, kde-format
msgctxt "@title"
msgid "Below-base Substitutions"
msgstr "Замествания под базовата линия"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:270
#, kde-format
msgctxt "@tooltip"
msgid "Controls below-base mark ligatures for Indic scripts."
msgstr "Контрол на лигатурите за знаци под базовата линия за индийски езици."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:273
#, kde-format
msgctxt "@title"
msgid "Conjunct Form After Ro"
msgstr "Форма за съединение след Ro"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:274
#, kde-format
msgctxt "@tooltip"
msgid "Controls glyphs following conjoined Ro in Khmer script."
msgstr "Контрол на глифите след съединено Ro в кхмерското писмо."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:277
#, kde-format
msgctxt "@title"
msgid "Conjunct Forms"
msgstr "Свързани форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:278
#, kde-format
msgctxt "@tooltip"
msgid "Controls conjunct forms in Indic scripts."
msgstr "Контрол на свързаните форми в индийските шрифтове."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:281
#, kde-format
msgctxt "@title"
msgid "Distances"
msgstr "Разстояния"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:282
#, kde-format
msgctxt "@tooltip"
msgid "Controls distances in Indic scripts, to avoid collisions."
msgstr ""
"Контрол на разстоянията в индийските шрифтове за избягване на застъпване."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:285
#, kde-format
msgctxt "@title"
msgid "Half Forms"
msgstr "Полуформи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:286
#, kde-format
msgctxt "@tooltip"
msgid "Replaces consonants in Indic scripts with their half forms."
msgstr "Замяна на съгласните в индийските азбуки с техните полуформи."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:289
#, kde-format
msgctxt "@title"
msgid "Halant Forms"
msgstr "Форми на халант"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:290
#, kde-format
msgctxt "@tooltip"
msgid "Replaces consonants in Indic scripts with their halant forms."
msgstr "Замяна на съгласните в индийските азбуки с техните халант форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:293
#, kde-format
msgctxt "@title"
msgid "Nukta Forms"
msgstr "Форми на Нукта"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:294
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces consonants combined with Nukta in Indic scripts with their Nukta "
"forms."
msgstr ""
"Замяна на съгласните, комбинирани с Nukta в индийските азбуки, с техните "
"Nukta форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:297
#, kde-format
msgctxt "@title"
msgid "Pre-base Forms"
msgstr "Предбазови форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:298
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces the pre-base form of a consonant in Khmer script, when a 'Coeng Ra' "
"situation occurs."
msgstr ""
"Замяна на пред-базовата форма на съгласна в кхмерското писмо при възникване "
"на ситуация „Coeng Ra“."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:301
#, kde-format
msgctxt "@title"
msgid "Pre-base Substitutions"
msgstr "Предварителни базови заместители"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:302
#, kde-format
msgctxt "@tooltip"
msgid "Replaces consonants with their pre-base forms in Indic scripts."
msgstr "Замяна на съгласните с техните пред-базови форми в индийските азбуки."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:305
#, kde-format
msgctxt "@title"
msgid "Post-base Forms"
msgstr "Форми след базовата"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:306
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces consonants with their post-base forms in Gurmukhi, Malayalam, and "
"Khmer."
msgstr ""
"Замяна на съгласните с техните пост-базови форми в Gurmukhi, Malayalam и "
"Khmer."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:309
#, kde-format
msgctxt "@title"
msgid "Post-base Substitutions"
msgstr "Заместители след базовите"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:310
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces base glyphs and post-base glyphs with a ligature in Indic scripts."
msgstr ""
"Замяна на базови глифи и пост-базови глифи с лигатура в индийски шрифтове."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:313
#, kde-format
msgctxt "@title"
msgid "Rakar Forms"
msgstr "Форми Rakar"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:314
#, kde-format
msgctxt "@tooltip"
msgid "Replaces sequences of glyphs in Indic scripts with their Rakar forms."
msgstr ""
"Замяна на последователности от глифи в индийски шрифтове с техните Rakar "
"форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:317
#, kde-format
msgctxt "@title"
msgid "Reph Form"
msgstr "Форма за преопределяне"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:318
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces Reph forms in Indic scripts with a consonant and Halant sequence."
msgstr ""
"Замяна на формите Reph в индийските азбуки с последователност от съгласна и "
"Halant."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:321
#, kde-format
msgctxt "@title"
msgid "Vattu Variants"
msgstr "Варианти на Vattu"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:322
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces ligatures in Indic scripts with a base consonant and Vattu form."
msgstr ""
"Замяна на лигатурите в индийските азбуки с базова съгласна и форма Vattu."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:327
#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:343
#, kde-format
msgctxt "@title"
msgid "Contextual Half-width Spacing"
msgstr "Контекстуално разстояние с полуширина"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:328
#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:440
#, kde-format
msgctxt "@tooltip"
msgid ""
"Respaces full-width glyphs to be half-width depending on the context, common "
"examples include CJK full-width brackets and other punctuation marks."
msgstr ""
"Пренареждане на пълноширинни глифи в полуширинни в зависимост от контекста; "
"типични примери са CJK пълноширинни скоби и други пунктуационни знаци."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:331
#, kde-format
msgctxt "@title"
msgid "Centered CJK Punctuation"
msgstr "Центрирана CJK пунктуация"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:332
#, kde-format
msgctxt "@tooltip"
msgid "Adjusts non-centered punctuation to be centered in CJK scripts."
msgstr "Центриране на нецентрираната пунктуация в CJK шрифтове."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:335
#, kde-format
msgctxt "@title"
msgid "Expert Forms"
msgstr "Експертни форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:336
#, kde-format
msgctxt "@tooltip"
msgid "Replaces standard forms in Japanese fonts with expert forms."
msgstr "Замяна на стандартните форми в японските шрифтове с експертни форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:339
#, kde-format
msgctxt "@title"
msgid "Full Widths"
msgstr "Пълна ширина"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:340
#, kde-format
msgctxt "@tooltip"
msgid "Replaces or respaces proportional glyphs with full-width glyphs."
msgstr ""
"Замяна или преразпределяне на пропорционалните глифи с глифи с пълна ширина."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:344
#, kde-format
msgctxt "@tooltip"
msgid ""
"Respaces full-width glyphs to be half-width, common examples include CJK "
"full-width brackets and other punctuation marks."
msgstr ""
"Преразпределение на пълните глифове към полуширина; често срещани примери са "
"CJK скобите с пълна ширина и други пунктуационни знаци."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:347
#, kde-format
msgctxt "@title"
msgid "Horizontal Kana Alternates"
msgstr "Хоризонтални алтернативи за Кана"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:348
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces standard kana in Japanese fonts with ones suited for horizontal "
"layout."
msgstr ""
"Замяна на стандартните кана в японските шрифтове с такива, подходящи за "
"хоризонтален разположение."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:351
#, kde-format
msgctxt "@title"
msgid "Hangul"
msgstr "Хангул"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:352
#, kde-format
msgctxt "@tooltip"
msgid "Replaces hanja in Korean with the corresponding hangul. Deprecated."
msgstr "Замяна на hanja в корейския език с съответния hangul. Остаряло."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:355
#, kde-format
msgctxt "@title"
msgid "Hojo Kanji Forms"
msgstr "Форми на Hojo Kanji"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:356
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces 'JIS X 0213:2004' form kanji in Japanese fonts with the Hojo ('JIS "
"X 0212-1990') forms."
msgstr ""
"Замяна на формите на канджи 'JIS X 0213:2004' в японските шрифтове с формите "
"Hojo ('JIS X 0212-1990')."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:359
#, kde-format
msgctxt "@title"
msgid "Half Widths"
msgstr "Полуширина"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:360
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces or respaces proportional or full-width glyphs with half-width "
"glyphs."
msgstr ""
"Замяна или пренареждане на пропорционални или широки глифи с тесни глифи."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:363
#, kde-format
msgctxt "@title"
msgid "Italics"
msgstr "Курсив"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:364
#, kde-format
msgctxt "@tooltip"
msgid "Replaces Latin glyphs in a CJK font with their italic forms."
msgstr "Замяна на латинските глифи в CJK шрифт с техните курсивни форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:367
#, kde-format
msgctxt "@title"
msgid "JIS78 Forms"
msgstr "Форми JIS78"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:368
#, kde-format
msgctxt "@tooltip"
msgid "Replaces standard form kanji in Japanese fonts with the JIS78 forms."
msgstr ""
"Замяна на стандартните форми на канджи в японските шрифтове с формите на "
"JIS78."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:371
#, kde-format
msgctxt "@title"
msgid "JIS83 Forms"
msgstr "Форми JIS83"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:372
#, kde-format
msgctxt "@tooltip"
msgid "Replaces standard form kanji in Japanese fonts with the JIS83 forms."
msgstr ""
"Замяна на стандартните форми на канджи в японските шрифтове с формите JIS83."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:375
#, kde-format
msgctxt "@title"
msgid "JIS90 Forms"
msgstr "Форми JIS90"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:376
#, kde-format
msgctxt "@tooltip"
msgid "Replaces standard form kanji in Japanese fonts with the JIS90 forms."
msgstr ""
"Замяна на стандартните форми на канджи в японските шрифтове с формите JIS90."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:379
#, kde-format
msgctxt "@title"
msgid "JIS2004 Forms"
msgstr "Форми JIS2004"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:380
#, kde-format
msgctxt "@tooltip"
msgid "Replaces standard form kanji in Japanese fonts with the JIS2004 forms."
msgstr ""
"Замяна на стандартните форми на канджи в японските шрифтове с формите на "
"JIS2004."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:383
#, kde-format
msgctxt "@title"
msgid "Leading Jamo Forms"
msgstr "Форми на водещи Джамо"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:384
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces sequences of leading class Hangul Jamo with a combined leading form."
msgstr ""
"Замяна на последователности от начални класове Hangul Jamo с комбинирана "
"начална форма."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:387
#, kde-format
msgctxt "@title"
msgid "NLC Kanji Forms"
msgstr "Форми на NLC Kanji"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:388
#, kde-format
msgctxt "@tooltip"
msgid "Replaces standard form kanji in Japanese fonts with the NLC forms."
msgstr ""
"Замяна на стандартните форми на канджи в японските шрифтове с формите на NLC."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:391
#, kde-format
msgctxt "@title"
msgid "Proportional Alternate Widths"
msgstr "Пропорционални алтернативни ширини"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:392
#, kde-format
msgctxt "@tooltip"
msgid "Respaces full-width glyphs to fit in a proportional context."
msgstr ""
"Преразпределя интервалите на глифи с пълна ширина за съответствие с "
"пропорционален контекст."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:395
#, kde-format
msgctxt "@title"
msgid "Proportional Kana"
msgstr "Пропорционални кана"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:396
#, kde-format
msgctxt "@tooltip"
msgid "Replaces full-width kana in Japanese fonts with proportional kana."
msgstr "Замяна на пълноширинни кана в японски шрифтове с пропорционални кана."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:399
#, kde-format
msgctxt "@title"
msgid "Proportional Widths"
msgstr "Пропорционални ширини"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:400
#, kde-format
msgctxt "@tooltip"
msgid "Replaces uniform-width glyphs with proportional glyphs."
msgstr "Замяна на глифи с еднаква ширина с пропорционални глифи."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:403
#, kde-format
msgctxt "@title"
msgid "Quarter Widths"
msgstr "Четвъртинна ширина"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:404
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with quarter-width glyphs."
msgstr "Замяна на глифи с глифи с четвърт ширина."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:407
#, kde-format
msgctxt "@title"
msgid "Ruby Notation Forms"
msgstr "Форми на руби нотация"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:408
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces glyphs in CJK fonts with ones suited for the small text in ruby "
"annotations."
msgstr ""
"Замяна на глифите в CJK шрифтовете с такива, подходящи за малък текст в руби "
"анотации."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:411
#, kde-format
msgctxt "@title"
msgid "Simplified Forms"
msgstr "Опростени форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:412
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs in CJK fonts with 'simplified' forms."
msgstr "Замяна на глифите в CJK шрифтовете с „опростени“ форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:415
#, kde-format
msgctxt "@title"
msgid "Trailing Jamo Forms"
msgstr "Форми на завършващи джамо"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:416
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces sequences of trailing class Hangul Jamo with a combined trailing "
"form."
msgstr ""
"Замяна на последователности от крайни класове Hangul Jamo с комбинирана "
"крайна форма."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:419
#, kde-format
msgctxt "@title"
msgid "Traditional Name Forms"
msgstr "Традиционни форми на имената"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:420
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces standard form Kanji in Japanese fonts with the ones traditionally "
"used in names."
msgstr ""
"Замяна на стандартните форми на Kanji в японските шрифтове с тези, които "
"традиционно се използват в имената."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:423
#, kde-format
msgctxt "@title"
msgid "Traditional Forms"
msgstr "Традиционни форми"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:424
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs in CJK fonts with 'traditional' forms."
msgstr "Замяна на глифите в CJK шрифтовете с „традиционни“ форми."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:427
#, kde-format
msgctxt "@title"
msgid "Third Widths"
msgstr "Трети ширини"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:428
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs with third-width glyphs."
msgstr "Замяна на глифи с глифи с третина от ширината."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:431
#, kde-format
msgctxt "@title"
msgid "Alternate Vertical Metrics"
msgstr "Алтернативни вертикални метрики"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:432
#, kde-format
msgctxt "@tooltip"
msgid "Repositions glyphs so they look more appropriate in vertical layout."
msgstr ""
"Препозициониране на глифите за по-подходящ изглед при вертикален макет."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:435
#, kde-format
msgctxt "@title"
msgid "Alternate Half Widths"
msgstr "Алтернативни полуширини"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:436
#, kde-format
msgctxt "@tooltip"
msgid "Repositions glyphs so they look more appropriate in horizontal layout."
msgstr ""
"Препозициониране на глифите за по-подходящ вид при хоризонтално разположение."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:439
#, kde-format
msgctxt "@title"
msgid "Vertical Contextual Half-width Spacing"
msgstr "Вертикално контекстуално разстояние с половин ширина"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:443
#, kde-format
msgctxt "@title"
msgid "Vertical Alternates"
msgstr "Вертикални алтернативи"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:444
#, kde-format
msgctxt "@tooltip"
msgid "Replaces glyphs in CJK fonts with ones suited for vertical writing."
msgstr ""
"Замяна на глифите в CJK шрифтовете с такива, подходящи за вертикално писане."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:447
#, kde-format
msgctxt "@title"
msgid "Alternate Vertical Half Metrics"
msgstr "Алтернативни вертикални полуметрики"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:448
#, kde-format
msgctxt "@tooltip"
msgid ""
"Repositions glyphs so they are half-width in a vertical writing context."
msgstr ""
"Препозициониране на глифите така, че да бъдат с половината ширина при "
"вертикален текст."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:451
#, kde-format
msgctxt "@title"
msgid "Vowel Jamo Forms"
msgstr "Форми на гласните джамо"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:452
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces sequences of vowel class Hangul Jamo with a combined vowel form."
msgstr ""
"Замяна на последователности от гласни Hangul Jamo с комбинирана гласна форма."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:455
#, kde-format
msgctxt "@title"
msgid "Vertical Kana Alternates"
msgstr "Вертикални алтернативи за Кана"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:456
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces standard kana in Japanese fonts with ones suited for vertical "
"layout."
msgstr ""
"Замяна на стандартните кана в японските шрифтове с такива, подходящи за "
"вертикално разположение."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:459
#, kde-format
msgctxt "@title"
msgid "Proportional Alternate Vertical Metrics"
msgstr "Пропорционални алтернативни вертикални метрики"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:460
#, kde-format
msgctxt "@tooltip"
msgid ""
"Repositions glyphs so they are proportional in a vertical writing context."
msgstr ""
"Препозициониране на глифите за постигане на пропорционалност при вертикално "
"писане."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:463
#, kde-format
msgctxt "@title"
msgid "Vertical Alternates for Rotation"
msgstr "Вертикални алтернативи за ротация"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:464
#, kde-format
msgctxt "@tooltip"
msgid "Replaces a subset of glyphs with rotated variants for vertical layout."
msgstr ""
"Замяна на подмножество от глифи с ротирани варианти за вертикално оформяне."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:467
#, kde-format
msgctxt "@title"
msgid "Vertical Alternates and Rotation"
msgstr "Вертикални алтернативи и ротация"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:468
#, kde-format
msgctxt "@tooltip"
msgid ""
"Replaces all horizontal-script glyphs with rotated variants for vertical "
"layout."
msgstr ""
"Замяна на всички глифи за хоризонтален шрифт с ротирани варианти за "
"вертикално разположение."

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:473
#, kde-format
msgctxt "@title"
msgid "Cursive Positioning"
msgstr "Позициониране на курсив"

#: libs/flake/text/KoOpenTypeFeatureInfoFactory.cpp:474
#, kde-format
msgctxt "@tooltip"
msgid "Adjusts the position of glyphs so they cursively connect."
msgstr "Регулиране на позицията на глифовете за курсивно свързване."

