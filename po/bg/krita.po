#. i18n: context: toolTip @ Action (text_type_preformatted), Actions (Interaction Tool), ActionCollection (Tools)
#: krita/data/actions/InteractionTool.action:303
#, kde-format
msgctxt "action"
msgid ""
"The text will not wrap and preserves spaces and new lines. A line break is "
"inserted so the lines from wrapping or positioning remain separated."
msgstr ""
"Текстът няма да се пренася и запазва интервалите и новите редове. Поставя се "
"разкъсване на реда, така че редовете от пренасяне или позициониране да "
"останат разделени."

#. i18n: context: text @ Action (text_type_inline_wrap), Actions (Interaction Tool), ActionCollection (Tools)
#: krita/data/actions/InteractionTool.action:311
#, kde-format
msgctxt "action"
msgid "Convert Text To Inline Wrapped"
msgstr "Преобразуване на текст в обвиващ се в редове"

#. i18n: context: iconText @ Action (text_type_inline_wrap), Actions (Interaction Tool), ActionCollection (Tools)
#: krita/data/actions/InteractionTool.action:312
