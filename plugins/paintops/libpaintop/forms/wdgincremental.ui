         <string>Build up</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblBuildup">
        <property name="text">
         <string>Applies strokes directly, building up opacity on the layer unless you use a blend mode that prevents it, such as Marker or Greater. Not available with masked brushes.</string>
