  <string name="donation_dialog_supporter_text">¡Gracias por apoyar a Krita! Tu colaboración ayuda a que su desarrollo continúe.</string>
  <string name="product_donations_description">&lt;h2&gt;Donativos&lt;/h2&gt;&lt;p&gt;Apoya el desarrollo continuo de Krita con un donativo directo a través de PayPal, o mediante tarjeta de crédito o débito, entre otros métodos de pago.&lt;/p&gt;</string>
  <string name="product_donations_button">Hacer un donativo</string>
  <string name="product_development_fund_description">&lt;h2&gt;Financiación de desarrollo&lt;/h2&gt;&lt;p&gt;Únase a la campaña de financiación del desarrollo de Krita y ayude a su continuo desarrollo con una contribución mensual. Existen diferentes niveles de beneficios.&lt;/p&gt;</string>
