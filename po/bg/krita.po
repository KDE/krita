#, kde-format
msgctxt "@info:tooltip"
msgid "Move: drag the image along the brush stroke"
msgstr "Преместване: влачене на изображението по хода на четката"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:279
#, kde-format
msgctxt "@info:tooltip"
msgid "Scale: grow/shrink image under cursor"
msgstr "Мащабиране: увеличаване/намаляване на изображението под курсора"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:280
#, kde-format
msgctxt "@info:tooltip"
msgid "Rotate: twirl image under cursor"
msgstr "Въртене: завъртане на изображението под курсора"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:281
#, kde-format
msgctxt "@info:tooltip"
msgid "Offset: shift the image to the right of the stroke direction"
msgstr ""
"Отместване: изместване на изображението надясно спрямо посоката на щрихата"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:282
#, kde-format
msgctxt "@info:tooltip"
msgid "Undo: erase actions of other tools"
msgstr "Отмяна: изтриване на действията на други инструменти"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:284
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Restore Shape: reduce local liquify stretching and bunching while keeping "
"the affected area centered"
msgstr ""
"Възстановяване на формата: намаляване на локалното разтягане и натрупване "
"при „втечняване“, като засегнатата област остане центрирана"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:304
#, kde-format
msgctxt "@info:tooltip"
msgid "Rotate the affected area back toward its original orientation"
msgstr "Връщане на засегнатата област към оригиналната ѝ ориентация"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:305
#, kde-format
msgctxt "@info:tooltip"
msgid "Keep the current rotation of the affected area"
msgstr "Запазване на текущото въртене на засегнатата област"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:306
#, kde-format
msgctxt "@info:tooltip"
msgid "Scale the affected area back toward its original size"
msgstr "Мащабиране на засегнатата област обратно към оригиналния размер"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:307
#, kde-format
msgctxt "@info:tooltip"
msgid "Keep the current overall scale of the affected area"
msgstr "Запазване на текущия общ мащаб на засегнатата област"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:308
#, kde-format
msgctxt "@info:tooltip"
msgid "Remove simple stretch or squash from the affected area"
msgstr "Премахване на просто разтягане или спляскване от засегнатата област"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:309
#, kde-format
msgctxt "@info:tooltip"
msgid "Keep simple stretch or squash while removing shear-like distortion"
msgstr ""
"Запазване на простото разтягане или свиване при премахване на деформации от "
"типа на отместване (shear)"

#: plugins/tools/tool_transform2/kis_tool_transform_config_widget.cpp:737
#, kde-format
