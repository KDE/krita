        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblClamp">
        <property name="text">
         <string>Prevents opacity from building up at all during a stroke, keeping edges soft and not compounding textures. Also known as "Soft" in other software.</string>
