#: plugins/impex/raw/3rdparty/libkdcraw/src/dcrawsettingswidget.cpp:726
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Camera Profile</title><p>Select here the input color space used to "
"decode RAW data.</p><p><ul><li><emphasis strong='true'>None</emphasis>: no "
"input color profile is used during RAW decoding.</li><li><emphasis "
"strong='true'>Embedded</emphasis>: use embedded color profile from RAW file, "
"if it exists.</li><li><emphasis strong='true'>Custom</emphasis>: use a "
"custom input color space profile.</li></ul></p>"
msgstr ""
"<title>Профил на камерата</title><p>Избор на входно цветово пространство за "
"декодиране на RAW данни.</p><p><ul><li><emphasis strong='true'>Няма</"
"emphasis>: не се използва входен цветов профил по време на RAW декодирането."
"</li><li><emphasis strong='true'>Вграден</emphasis>: използване на вградения "
"цветов профил от RAW файла, ако такъв съществува.</li><li><emphasis "
"strong='true'>Потребителски</emphasis>: използване на потребителски профил "
"на входното цветово пространство.</li></ul></p>"

