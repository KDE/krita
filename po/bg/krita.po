msgctxt "@label:inlistbox"
msgid "Allow hanging commas"
msgstr "Разрешаване на висящи запетаи"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:134
#, kde-format
msgctxt "@label:inlistbox"
msgid "Force hanging commas"
msgstr "Принудително висящи запетаи"

#: plugins/dockers/textproperties/qml/HangingPunctuation.qml:150
